# === Database Connection ===
# Option 1: Single connection URL (recommended for Railway, Render, etc.)
# DATABASE_URL=mysql://user:password@host:3306/dbname

# Option 2: Individual variables (for cPanel, local dev, etc.)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nuttymilk

# === App Settings ===
PORT=5001
JWT_SECRET=change_this_to_a_long_random_string

# === Admin Account (created on first run) ===
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@nuttymilk.com
ADMIN_PASSWORD=change_this_password

# === Email (optional) ===
# RESEND_API_KEY=re_your_api_key_here
# FROM_EMAIL=NuttyMilk <noreply@yourdomain.com>

# === SMS (optional) ===
# KAVENEGAR_API_KEY=your_kavenegar_api_key_here
# KAVENEGAR_SENDER=10008663
