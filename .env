KAVENEGAR_SENDER=10008663


#App loads fine. Done! Here's the summary:
  
#  What changed
  
#  Email verification — now uses Resend (mailer.js):
 # 
 # - Replace your RESEND_API_KEY in .env with a real key from resend.com (https://resend.com)
#  - Set FROM_EMAIL to your verified domain (e.g., NuttyMilk <noreply@nuttymilk.com>)
  
#  SMS verification — now uses Kavenegar (sms.js):
  
 # - Replace KAVENEGAR_API_KEY in .env with your key from kavenegar.com (https://kavenegar.com)
#  - KAVENEGAR_SENDER is the sender line number (default 10008663 is Kavenegar's shared line)
  
 # Auth routes — all dev_code responses removed. Now:
  
#  - Email users → get a real email with the 5-digit code
#  - Phone users → get a real SMS with the code
# - If sending fails → returns 500 with error message
  
 # Setup steps:
  
 # 1. Sign up at resend.com (https://resend.com), get API key, verify your domain
 # 2. Sign up at kavenegar.com (https://kavenegar.com), get API key
 # 3. Update .env:
  
 # RESEND_API_KEY=re_xxxxxxxxxxxxx
 # FROM_EMAIL=NuttyMilk <noreply@yourdomain.com>
 # KAVENEGAR_API_KEY=xxxxxxxxxxxxx